# Copy to .env and fill in your own values
# DO NOT commit the actual .env file

# Telegram bot for trading reports (optional; leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Finnhub API key for realtime US equity quotes (optional)
# Get a free key at https://finnhub.io
FINNHUB_API_KEY=

# Set to 1 to disable all Telegram notifications regardless of token
QUANT_DISABLE_TELEGRAM=0
