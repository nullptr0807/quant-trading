    "enabled": True,              # 总开关：True=启用自适应, False=固定周期
    "vol_window": 5,               # 波动率计算窗口（天）
    "ref_window": 60,              # 参考波动率窗口（天，取中位数）
    "min_hours": 12,               # 最短换仓周期（小时）
    "max_hours": 96,               # 最长换仓周期（小时）
    "silence_threshold": 0.3,      # 静默区阈值（σ_t < σ_ref * 此值时暂停交易）
}

